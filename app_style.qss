/* =========================================================
   하비 브라운 엑셀 도구 – FINAL QSS
   컨셉:
   - 세련된 핑크(Blush Pink)
   - 카드형 그룹 (가짜 그림자: 하단 보더)
   - 입력창/버튼 "작고 정제된" 비율
   - 레이아웃 절대 파괴하지 않음
   ========================================================= */


/* =========================================================
   1. 공통 / 배경 / 타이포 / 탭 색상
   ========================================================= */

* {
    font-family: "Malgun Gothic";
    font-size: 9.5pt;
    color: #1f2328;
}

QMainWindow,
QWidget {
    background: #f5f6f8;   /* 연회색 베이스 */
}

/* 스크롤 영역 검정 방지 */
QScrollArea,
QAbstractScrollArea {
    background: transparent;
    border: none;
}

QAbstractScrollArea::viewport {
    background: #f5f6f8;
}

QWidget#tab_pink   { background-color: #fff3f7; }
QWidget#tab_dark   { background-color: #1f2329; }
QWidget#tab_blue   { background-color: #f3f7ff; }
QWidget#tab_orange { background-color: #fbf7f3; }



/* =========================================================
   2. 탭 (크기 안정 + 핑크 포인트)
   ========================================================= */

QTabWidget::pane {
    border: 1px solid #e6e8ef;
    border-radius: 14px;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    padding: 8px 18px;
    margin-right: 8px;

    border: 1px solid #e6e8ef;
    border-bottom: none;

    border-top-left-radius: 14px;
    border-top-right-radius: 14px;

    background: #eef1f4;
    color: #2b2f36;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #f4f6f9;
}

QTabBar::tab:selected {
    background: #f7d3dc;          /* 메인 핑크 */
    border-color: #e6a8b6;
    color: #3a1f27;
    font-weight: 700;
}


/* =========================================================
   3. 그룹박스 (카드 느낌 + 가짜 그림자)
   ========================================================= */

QGroupBox {
    background: #ffffff;
    border: 1px solid #f0c9d2;
    border-bottom: 3px solid #e3b2bd;   /* 가짜 shadow */
    border-radius: 16px;

    margin-top: 22px;
    padding: 6px;   /* ❗ 최소만 – 레이아웃 안전 */
}

/* 그룹 제목 (핑크 pill, 과하지 않게) */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    margin-left: 12px;
    margin-top: 8px;

    padding: 3px 9px;
    background: #f7d3dc;
    color: #3a1f27;

    border-radius: 10px;
    font-weight: 700;
}


/* =========================================================
   4. 그룹 내부 소제목 라벨 (투박함 제거)
   ========================================================= */

QLabel[sectionTitle="true"] {
    font-weight: 600;
    color: #4a2a33;
}


/* =========================================================
   5. 입력창 (작고 정제된 비율)
   ========================================================= */

QLineEdit,
QDateEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e9c1cb;
    border-radius: 9px;

    padding: 5px 9px;
    min-height: 28px;     /* ❗ 작게 */
    margin: 2px;          /* 붙어보임 방지 */

    font-size: 9.3pt;
}

QLineEdit:focus,
QDateEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #e19dad;
    background: #fff7f9;
}

/* DateEdit 우측 버튼 영역 */
QDateEdit {
    padding-right: 32px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;

    background: #f6f7fb;
    border-left: 1px solid #e9c1cb;

    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

/* ComboBox 드롭다운 */
QComboBox::drop-down {
    width: 26px;
    border-left: 1px solid #e9c1cb;
    background: #f6f7fb;

    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}


/* =========================================================
   6. 버튼 (촌스러움 제거 – 작고 단단하게)
   ========================================================= */

QPushButton {
    background: #ffffff;
    border: 1px solid #e6e8ef;
    border-radius: 12px;

    padding: 6px 14px;
    min-height: 30px;     /* ❗ 작게 */

    font-size: 9.3pt;
    font-weight: 600;
    color: #1f2328;
}

QPushButton:hover {
    background: #fff1f4;
    border-color: #e9c1cb;
}

QPushButton:pressed {
    background: #ffe6ed;
    border-color: #e19dad;
}

/* 포인트 버튼 */
QPushButton[accent="true"] {
    background: #e9aab7;
    border-color: #e9aab7;
    color: #ffffff;
    font-weight: 700;
}

QPushButton[accent="true"]:hover {
    background: #df95a6;
    border-color: #df95a6;
}


/* =========================================================
   7. 테이블 (정제된 헤더 + 카드 톤)
   ========================================================= */

QTableWidget,
QTableView {
    background: #ffffff;
    border: 1px solid #e6e8ef;
    border-bottom: 3px solid #d8dbe3;
    border-radius: 16px;

    gridline-color: #eef0f6;
}

QHeaderView::section {
    background: #f3f5f8;
    color: #2b2f36;

    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #e6e8ef;

    font-weight: 700;
    font-size: 9.2pt;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background: #fff1f4;
    color: #1f2328;
}


/* =========================================================
   8. 스크롤바 (미니멀)
   ========================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 8px 4px;
}

QScrollBar::handle:vertical {
    background: #cfd6df;
    border-radius: 6px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background: #bfc8d3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* =========================================================
   두번째 탭 (네이버/쿠팡 송장) - Dark Modern "톤만" (검은 덩어리 금지)
   적용 조건: ReadInvoiceWidget objectName == tab_dark
   ========================================================= */

/* 2탭 전체 배경: 연회색 */
QWidget#tab_dark {
    background: #f4f6f9;
    color: #111827;
}

/* -------------------------
   상단 컨트롤 바 (ship_top)
   ------------------------- */
QWidget#tab_dark QWidget#ship_top {
    background: #eef2f7;
    border: 1px solid #d7dee8;
    border-radius: 14px;
}

/* 상단 컨트롤 요소들 */
QWidget#tab_dark QWidget#ship_top QLabel {
    color: #111827;
    font-weight: 700;
}

QWidget#tab_dark QWidget#ship_top QComboBox,
QWidget#tab_dark QWidget#ship_top QLineEdit {
    background: #ffffff;
    border: 1px solid #cfd8e3;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 30px;
}

/* 상단 “엑셀 불러오기” 버튼: 다크모던 포인트 */
QWidget#tab_dark QWidget#ship_top QPushButton {
    background: #24324a;
    border: none;
    color: #ffffff;
    border-radius: 12px;
    padding: 8px 14px;
    min-height: 34px;
    font-weight: 800;
}
QWidget#tab_dark QWidget#ship_top QPushButton:hover { background: #2f4060; }
QWidget#tab_dark QWidget#ship_top QPushButton:pressed { background: #1e2a40; }

/* -------------------------
   테이블 (ship_table) : "화이트 카드 + 헤더만 다크"
   ------------------------- */
QWidget#tab_dark QTableWidget#ship_table,
QWidget#tab_dark QTableView#ship_table {
    background: #ffffff;
    border: 1px solid #d7dee8;
    border-radius: 16px;
    gridline-color: #e6ebf2;
    selection-background-color: #dbeafe; /* 연한 하늘색 선택 */
    selection-color: #0b1220;
}

/* 헤더: 다크 슬레이트 */
QWidget#tab_dark QHeaderView::section {
    background: #1f2a3a;
    color: #ffffff;
    border: none;
    border-right: 1px solid #2a3a52;
    padding: 10px 10px;
    font-weight: 900;
}

/* -------------------------
   문자 전송 패널 (ship_sms) : 연한 하늘색 카드
   ------------------------- */
QWidget#tab_dark QGroupBox#ship_sms {
    background: #eef4fb;
    border: 1px solid #d6e3f3;
    border-radius: 16px;
    padding: 12px;
}

/* 문자 전송 그룹 제목: 과하지 않게 */
QWidget#tab_dark QGroupBox#ship_sms::title {
    subcontrol-origin: margin;
    left: 14px;
    top: -10px;
    padding: 2px 10px;
    background: #e7effa;
    border: 1px solid #d6e3f3;
    border-radius: 10px;
    color: #1f2937;
    font-weight: 900;
}

/* 문자 전송 패널 안 입력 */
QWidget#tab_dark QGroupBox#ship_sms QLineEdit,
QWidget#tab_dark QGroupBox#ship_sms QDateTimeEdit,
QWidget#tab_dark QGroupBox#ship_sms QComboBox {
    background: #ffffff;
    border: 1px solid #c7d6ea;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 30px;
}

/* 문자 전송 패널 버튼: 다크 포인트 통일 */
QWidget#tab_dark QGroupBox#ship_sms QPushButton {
    background: #24324a;
    border: none;
    color: #ffffff;
    border-radius: 12px;
    padding: 8px 12px;
    min-height: 34px;
    font-weight: 800;
}
QWidget#tab_dark QGroupBox#ship_sms QPushButton:hover { background: #2f4060; }
QWidget#tab_dark QGroupBox#ship_sms QPushButton:pressed { background: #1e2a40; }

/* -------------------------
   로그 (ship_log) : 연회색 카드
   ------------------------- */
QWidget#tab_dark QPlainTextEdit#ship_log {
    background: #ffffff;
    border: 1px solid #d7dee8;
    border-radius: 16px;
    padding: 10px;
    color: #111827;
}

/* =========================================================
   세번째 탭 (스케줄) - Blue Smooth (최종/단일정의)
   적용 조건: 스케줄 탭 위젯 objectName == tab_blue
   ========================================================= */

/* =========================================================
   1) 베이스
   ========================================================= */
QWidget#tab_blue {
    background: #f3f7ff;
    color: #0f172a;
}

/* =========================================================
   2) 카드(그룹박스)
   ========================================================= */
QWidget#tab_blue QGroupBox {
    background: #ffffff;
    border: 1px solid #d6e3ff;
    border-bottom: 3px solid #c8d8ff;   /* fake shadow */
    border-radius: 16px;

    margin-top: 18px;
    padding: 14px;
    padding-top: 22px;                  /* title 공간 */
}

QWidget#tab_blue QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    margin-left: 12px;
    margin-top: 8px;

    padding: 4px 12px;
    border-radius: 999px;

    background: #e7f1ff;
    border: 1px solid #b9d3ff;
    color: #0b3b75;
    font-weight: 900;
}

/* =========================================================
   3) 입력/콤보
   ========================================================= */
QWidget#tab_blue QLineEdit,
QWidget#tab_blue QDateEdit,
QWidget#tab_blue QDateTimeEdit,
QWidget#tab_blue QTextEdit,
QWidget#tab_blue QPlainTextEdit,
QWidget#tab_blue QComboBox {
    background: #ffffff;
    border: 1px solid #c7d6f5;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 30px;
    color: #0f172a;
}

QWidget#tab_blue QLineEdit:focus,
QWidget#tab_blue QDateEdit:focus,
QWidget#tab_blue QDateTimeEdit:focus,
QWidget#tab_blue QTextEdit:focus,
QWidget#tab_blue QPlainTextEdit:focus,
QWidget#tab_blue QComboBox:focus {
    background: #f7fbff;
    border-color: #6aaeff;
}

/* =========================================================
   4) 버튼 (기본 + accent 옵션)
   ========================================================= */
QWidget#tab_blue QPushButton {
    background: #ffffff;
    border: 1px solid #b9d3ff;
    color: #0b3b75;
    border-radius: 12px;
    padding: 8px 14px;
    min-height: 34px;
    font-weight: 900;
}

QWidget#tab_blue QPushButton:hover {
    background: #eaf3ff;
    border-color: #8cbaff;
}

QWidget#tab_blue QPushButton:pressed {
    background: #dbeafe;
}

QWidget#tab_blue QPushButton[accent="true"] {
    background: #2b6cb0;
    border: none;
    color: #ffffff;
}
QWidget#tab_blue QPushButton[accent="true"]:hover { background: #2f75c2; }
QWidget#tab_blue QPushButton[accent="true"]:pressed { background: #245f9a; }

/* =========================================================
   5) 달력 (선택색/버튼/뷰)
   - 주의: 달력 요일바를 "외부 weekdayBar"로 쓰는 구조라면,
           QHeaderView::section 스타일은 넣지 않는다 (충돌 방지).
   ========================================================= */
QWidget#tab_blue QCalendarWidget {
    background: #ffffff;
    border: 1px solid #d6e3ff;
    border-radius: 16px;
}

QWidget#tab_blue QCalendarWidget QAbstractItemView:enabled {
    background: #ffffff;
    selection-background-color: #cfe8ff;  /* 연파랑 */
    selection-color: #0f172a;
}

/* 달력 내부 네비 버튼(만약 navigationBarVisible True일 때도 안전) */
QWidget#tab_blue QCalendarWidget QToolButton {
    background: #e7f1ff;
    border: 1px solid #b9d3ff;
    border-radius: 10px;
    padding: 6px 10px;
    color: #0b3b75;
    font-weight: 900;
}
QWidget#tab_blue QCalendarWidget QToolButton:hover { background: #dbeafe; }

/* =========================================================
   6) 외부 네비게이션 바 (우리가 만든 calNavBar 쓸 때)
   ========================================================= */
QWidget#tab_blue #calNavBar {
    background: transparent;
}

QWidget#tab_blue #calPrevBtn,
QWidget#tab_blue #calNextBtn {
    min-width: 36px;
    min-height: 30px;
    border-radius: 10px;
    border: 1px solid #cfe0ff;
    background: #f3f8ff;
    font-weight: 900;
    color: #0b3b75;
}

QWidget#tab_blue #calPrevBtn:hover,
QWidget#tab_blue #calNextBtn:hover {
    background: #e7f1ff;
}

QWidget#tab_blue #calMonthCombo,
QWidget#tab_blue #calYearCombo {
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 10px;
    border: 1px solid #cfe0ff;
    background: #ffffff;
    font-weight: 800;
    color: #0f172a;
}

/* =========================================================
   7) 외부 요일 바 (weekdayBar) - 일/토 색상
   ========================================================= */
QWidget#tab_blue #weekdayBar {
    background: transparent;
    border: none;
}

QWidget#tab_blue #weekdaySun  { color: #d7263d; font-weight: 900; }
QWidget#tab_blue #weekdaySat  { color: #1d4ed8; font-weight: 900; }
QWidget#tab_blue #weekdayWeek { color: #111827; font-weight: 800; }

/* =========================================================
   8) 스크롤바(최소만)
   ========================================================= */
QWidget#tab_blue QScrollBar::handle:vertical { background: #9cc7ff; }
QWidget#tab_blue QScrollBar::handle:vertical:hover { background: #7fb3ff; }

/* =========================================================
   TAB 4 – ORANGE / AMBER (UpdateWidget 전용)
   적용 조건: 업데이트 탭 위젯 objectName == tab_orange
   ========================================================= */

QWidget#tab_orange {
    background: #fbf7f3;
    color: #1f2328;
}

/* 타이틀 */
QWidget#tab_orange QLabel#updateTitle {
    font-size: 12pt;
    font-weight: 900;
    color: #2b2f36;
    padding: 4px 2px;
}

/* 정보 라벨 */
QWidget#tab_orange QLabel#updateRepo,
QWidget#tab_orange QLabel#updateHash {
    color: #384150;
    font-weight: 600;
    padding: 1px 2px;
}

/* 버튼 공통 */
QWidget#tab_orange QPushButton#btnUpdateRefresh,
QWidget#tab_orange QPushButton#btnUpdatePull {
    min-height: 34px;
    padding: 7px 14px;
    border-radius: 12px;
    font-weight: 900;
}

/* 새로고침(서브) */
QWidget#tab_orange QPushButton#btnUpdateRefresh {
    background: #ffffff;
    border: 1px solid #e6e8ef;
    color: #2b2f36;
}
QWidget#tab_orange QPushButton#btnUpdateRefresh:hover {
    background: #fff4ec;
    border-color: #ffd2b3;
}
QWidget#tab_orange QPushButton#btnUpdateRefresh:pressed {
    background: #ffe8d7;
}

/* 업데이트 실행(메인 강조) */
QWidget#tab_orange QPushButton#btnUpdatePull {
    background: #ff9a57;
    border: 1px solid #ff9a57;
    color: #ffffff;
}
QWidget#tab_orange QPushButton#btnUpdatePull:hover {
    background: #ff8a3d;
    border-color: #ff8a3d;
}
QWidget#tab_orange QPushButton#btnUpdatePull:pressed {
    background: #f37c2a;
    border-color: #f37c2a;
}

/* 로그: 카드형 */
QWidget#tab_orange QPlainTextEdit#updateLog {
    background: #ffffff;
    border: 1px solid #ffd2b3;
    border-bottom: 3px solid #f2b48a;  /* fake shadow */
    border-radius: 14px;
    padding: 10px 12px;
    color: #1f2328;
}
QWidget#tab_orange QPlainTextEdit#updateLog:focus {
    border-color: #ff9a57;
    background: #fffaf5;
}
