/* =========================================================
   하비 브라운 엑셀 도구 – FINAL QSS
   컨셉:
   - 세련된 핑크(Blush Pink)
   - 카드형 그룹 (가짜 그림자: 하단 보더)
   - 입력창/버튼 "작고 정제된" 비율
   - 레이아웃 절대 파괴하지 않음
   ========================================================= */


/* =========================================================
   1. 공통 / 배경 / 타이포
   ========================================================= */

* {
    font-family: "Malgun Gothic";
    font-size: 9.5pt;
    color: #1f2328;
}

QMainWindow,
QWidget {
    background: #f5f6f8;   /* 연회색 베이스 */
}

/* 스크롤 영역 검정 방지 */
QScrollArea,
QAbstractScrollArea {
    background: transparent;
    border: none;
}

QAbstractScrollArea::viewport {
    background: #f5f6f8;
}


/* =========================================================
   2. 탭 (크기 안정 + 핑크 포인트)
   ========================================================= */

QTabWidget::pane {
    border: 1px solid #e6e8ef;
    border-radius: 14px;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    padding: 8px 18px;
    margin-right: 8px;

    border: 1px solid #e6e8ef;
    border-bottom: none;

    border-top-left-radius: 14px;
    border-top-right-radius: 14px;

    background: #eef1f4;
    color: #2b2f36;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #f4f6f9;
}

QTabBar::tab:selected {
    background: #f7d3dc;          /* 메인 핑크 */
    border-color: #e6a8b6;
    color: #3a1f27;
    font-weight: 700;
}


/* =========================================================
   3. 그룹박스 (카드 느낌 + 가짜 그림자)
   ========================================================= */

QGroupBox {
    background: #ffffff;
    border: 1px solid #f0c9d2;
    border-bottom: 3px solid #e3b2bd;   /* 가짜 shadow */
    border-radius: 16px;

    margin-top: 22px;
    padding: 6px;   /* ❗ 최소만 – 레이아웃 안전 */
}

/* 그룹 제목 (핑크 pill, 과하지 않게) */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    margin-left: 12px;
    margin-top: 8px;

    padding: 3px 9px;
    background: #f7d3dc;
    color: #3a1f27;

    border-radius: 10px;
    font-weight: 700;
}


/* =========================================================
   4. 그룹 내부 소제목 라벨 (투박함 제거)
   ========================================================= */

QLabel[sectionTitle="true"] {
    font-weight: 600;
    color: #4a2a33;
}


/* =========================================================
   5. 입력창 (작고 정제된 비율)
   ========================================================= */

QLineEdit,
QDateEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e9c1cb;
    border-radius: 9px;

    padding: 5px 9px;
    min-height: 28px;     /* ❗ 작게 */
    margin: 2px;          /* 붙어보임 방지 */

    font-size: 9.3pt;
}

QLineEdit:focus,
QDateEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #e19dad;
    background: #fff7f9;
}

/* DateEdit 우측 버튼 영역 */
QDateEdit {
    padding-right: 32px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;

    background: #f6f7fb;
    border-left: 1px solid #e9c1cb;

    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

/* ComboBox 드롭다운 */
QComboBox::drop-down {
    width: 26px;
    border-left: 1px solid #e9c1cb;
    background: #f6f7fb;

    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}


/* =========================================================
   6. 버튼 (촌스러움 제거 – 작고 단단하게)
   ========================================================= */

QPushButton {
    background: #ffffff;
    border: 1px solid #e6e8ef;
    border-radius: 12px;

    padding: 6px 14px;
    min-height: 30px;     /* ❗ 작게 */

    font-size: 9.3pt;
    font-weight: 600;
    color: #1f2328;
}

QPushButton:hover {
    background: #fff1f4;
    border-color: #e9c1cb;
}

QPushButton:pressed {
    background: #ffe6ed;
    border-color: #e19dad;
}

/* 포인트 버튼 */
QPushButton[accent="true"] {
    background: #e9aab7;
    border-color: #e9aab7;
    color: #ffffff;
    font-weight: 700;
}

QPushButton[accent="true"]:hover {
    background: #df95a6;
    border-color: #df95a6;
}


/* =========================================================
   7. 테이블 (정제된 헤더 + 카드 톤)
   ========================================================= */

QTableWidget,
QTableView {
    background: #ffffff;
    border: 1px solid #e6e8ef;
    border-bottom: 3px solid #d8dbe3;
    border-radius: 16px;

    gridline-color: #eef0f6;
}

QHeaderView::section {
    background: #f3f5f8;
    color: #2b2f36;

    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #e6e8ef;

    font-weight: 700;
    font-size: 9.2pt;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background: #fff1f4;
    color: #1f2328;
}


/* =========================================================
   8. 스크롤바 (미니멀)
   ========================================================= */

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 8px 4px;
}

QScrollBar::handle:vertical {
    background: #cfd6df;
    border-radius: 6px;
    min-height: 36px;
}

QScrollBar::handle:vertical:hover {
    background: #bfc8d3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
